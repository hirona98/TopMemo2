{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "publish: single-file win-x64",
      "type": "process",
      "command": "dotnet",
      "args": [
        "publish",
        "${workspaceFolder}/TopMemo2.csproj",
        "--configuration",
        "Release",
        "--runtime",
        "win-x64",
        "--self-contained",
        "true",
        "-p:PublishSingleFile=true",
        "-p:IncludeNativeLibrariesForSelfExtract=true",
        "-p:EnableCompressionInSingleFile=true",
        "--output",
        "${workspaceFolder}/bin/publish/win-x64-single"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "run: published single-file",
      "type": "process",
      "command": "${workspaceFolder}/bin/publish/win-x64-single/TopMemo2.exe",
      "dependsOn": "publish: single-file win-x64",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    }
  ]
}
